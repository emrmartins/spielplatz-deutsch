{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spielplatz-deutsch",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-28",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "PROGRESS",
      "id": "b4fe9ae518f3420ab496fb3047e329a9"
    }
  ]
}
